# Copy to .env.local. Everything VITE_-prefixed is bundled into the client and
# is therefore public — never put a service-role key or any secret here.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...

# Leave blank in local development to use Vite's /api proxy to localhost:8000.
# In production set it to your Render service URL.
VITE_API_BASE_URL=
