# Copy to .env and fill in. Never commit .env.

# ---------- Application ----------
ENVIRONMENT=local              # local | dev | staging | prod
DEBUG=true
LOG_LEVEL=INFO
LOG_FORMAT=console             # console | json  (use json on Render)
CORS_ORIGINS=["http://localhost:5173"]

# ---------- Supabase ----------
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...
# Only needed for projects still on the legacy shared HS256 secret.
# Leave blank to verify tokens against the project's JWKS endpoint.
SUPABASE_JWT_SECRET=

# ---------- Database ----------
# Runtime: transaction pooler (port 6543). asyncpg cannot use prepared
# statements through the pooler, hence the cache size override.
DATABASE_URL=postgresql+asyncpg://postgres.ref:password@aws-0-region.pooler.supabase.com:6543/postgres?prepared_statement_cache_size=0
# Migrations: direct connection (port 5432).
ALEMBIC_DATABASE_URL=postgresql+asyncpg://postgres:password@db.your-project-ref.supabase.co:5432/postgres
# A THROWAWAY database for the migration parity tests, which drop every table.
# Deliberately separate from the two above so `pytest` can never destroy data
# you care about. Leave blank and those tests skip.
ALEMBIC_TEST_DATABASE_URL=
DB_ECHO=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5

# ---------- Anthropic ----------
# Leave blank to run on the deterministic fixture LLM (no network calls).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_STRUCTURED=claude-sonnet-5
ANTHROPIC_MODEL_NARRATIVE=claude-opus-5
ANTHROPIC_MAX_TOKENS=4096
ANTHROPIC_TIMEOUT_SECONDS=120

# ---------- Jira ----------
# Leave JIRA_BASE_URL blank to run on fixtures.
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=

# ---------- GitHub ----------
GITHUB_TOKEN=

# ---------- Teams ----------
# Simple path: an incoming webhook URL for the pod channel.
TEAMS_WEBHOOK_URL=
# Full path (reading messages/reactions) needs a Graph app registration.
TEAMS_TENANT_ID=
TEAMS_CLIENT_ID=
TEAMS_CLIENT_SECRET=

# ---------- Agent policy ----------
SCHEDULER_ENABLED=false
GROUNDING_MIN_CITATION_RATIO=0.9
APPROVAL_EXPIRY_HOURS=24
MAX_NUDGES_PER_PERSON_PER_DAY=3
BLOCKER_AGE_DAYS_BEFORE_RISK=2

# ---------- Onboarding ----------
# Anyone who signs in gets a workspace immediately. With this off, a new
# account belongs to no engagement, every page renders with a null engagement
# id, and every action fails — so leave it on unless you want invite-only.
AUTO_JOIN_NEW_USERS=true
# Engagement new users join. Blank = the first active one; if none exists, a
# workspace is created so a fresh database is never a dead end.
DEFAULT_ENGAGEMENT_SLUG=

# ---------- A2A ----------
# Shared secret the Meeting Agent signs its meeting_outcome posts with.
MEETING_AGENT_WEBHOOK_SECRET=

# ---------- Email delivery ----------
# Not configured here. Sign-in emails are sent by Supabase, so SMTP lives in
# the Supabase project (Project Settings -> Auth -> SMTP), not in this file.
#
# Two things are worth knowing, both learned the hard way:
#   1. On the free tier with Supabase's DEFAULT sender you cannot edit email
#      templates, so codes cannot be put in the message and only a link is
#      sent. Configuring any custom SMTP unlocks template editing.
#   2. The default sender is limited to a few emails per hour, project-wide.

# ---------- Local development only ----------
# Treats every request as this user and requires no token, so the UI is usable
# before Supabase is configured. Honoured ONLY when ENVIRONMENT=local — the
# application refuses to start if it is set in dev, staging or prod.
# Leave blank unless you mean it.
DEV_AUTH_BYPASS_EMAIL=
